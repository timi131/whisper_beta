#!/bin/bash

set -eu

APP_NAME="Whisper Beta"
SUPPORT_DIR="$HOME/Library/Application Support/WhisperBeta"
VENV_DIR="$SUPPORT_DIR/venv"
LOG_FILE="$SUPPORT_DIR/server.log"
PID_FILE="$SUPPORT_DIR/server.pid"
PORT="${PORT:-8000}"
URL="http://127.0.0.1:${PORT}"

mkdir -p "$SUPPORT_DIR"

if [[ -f "$PID_FILE" ]]; then
    SERVER_PID="$(cat "$PID_FILE" 2>/dev/null || true)"
    if [[ -n "$SERVER_PID" ]] && kill -0 "$SERVER_PID" 2>/dev/null; then
        open "$URL"
        exit 0
    fi
fi

if ! command -v python3 >/dev/null 2>&1; then
    osascript -e 'display dialog "Не найден Python 3. Установите Xcode Command Line Tools командой: xcode-select --install" buttons {"OK"} default button "OK" with icon stop'
    exit 1
fi

RESOURCES_DIR="$(cd "$(dirname "$0")/../Resources" && pwd)"

cp "$RESOURCES_DIR/app.py" "$SUPPORT_DIR/app.py"
cp "$RESOURCES_DIR/requirements.txt" "$SUPPORT_DIR/requirements.txt"

if [[ ! -x "$VENV_DIR/bin/python" ]]; then
    osascript -e 'display notification "Создаётся локальное окружение Whisper Beta…" with title "Whisper Beta"' >/dev/null 2>&1 || true
    python3 -m venv "$VENV_DIR"
fi

"$VENV_DIR/bin/python" -m pip install --upgrade pip
"$VENV_DIR/bin/python" -m pip install -r "$SUPPORT_DIR/requirements.txt"

osascript -e 'display notification "Модель Whisper загружается при первом запуске. Сервер запускается…" with title "Whisper Beta"' >/dev/null 2>&1 || true

(
    cd "$SUPPORT_DIR"
    HOST=127.0.0.1 \
    PORT="$PORT" \
    REC_DIR="$SUPPORT_DIR/recordings" \
    nohup "$VENV_DIR/bin/python" app.py >>"$LOG_FILE" 2>&1 &
    echo $! >"$PID_FILE"
)

for _ in $(seq 1 120); do
    if curl --fail --silent "$URL/api/recordings" >/dev/null 2>&1; then
        open "$URL"
        exit 0
    fi
    if [[ -f "$PID_FILE" ]]; then
        SERVER_PID="$(cat "$PID_FILE" 2>/dev/null || true)"
        [[ -n "$SERVER_PID" ]] && ! kill -0 "$SERVER_PID" 2>/dev/null && break
    fi
    sleep 0.5
done

osascript -e "display dialog \"Не удалось запустить Whisper Beta. Проверьте журнал:\n$LOG_FILE\" buttons {\"OK\"} default button \"OK\" with icon stop"
exit 1
